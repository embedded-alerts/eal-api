APP_ENV=development
# Development/test-only compatibility mode. Never enable this in production.
# Clients using this mode must send X-Eal-Tenant-Id, X-Eal-Subject-Id, and
# X-Eal-Roles on every non-health request.
ALLOW_INSECURE_TENANT_HEADER=true

RUST_LOG=info,eal=debug
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eal
MIGRATE_ON_STARTUP=false
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083

# Verified user/browser JWT configuration. HS256 secrets must contain at least 32 bytes.
# Production requires the secret, issuer, audience, durable schema, and explicit origins;
# it never falls back to development identity headers.
EAL_JWT_HS256_SECRET=
EAL_JWT_ISSUER=https://auth.example.com
EAL_JWT_AUDIENCE=eal-api
EAL_JWT_TENANT_CLAIM=tenant_id
EAL_JWT_ROLE_CLAIM=role
EAL_JWT_ALLOWED_ROLES=authenticated,member,admin,owner
EAL_JWT_TENANT_ADMIN_ROLES=admin,owner
EAL_JWT_COOKIE_NAME=eal_access_token
EAL_JWT_LEEWAY_SECONDS=30

# Store only the lowercase SHA-256 digest in the API environment. The crawler
# receives the high-entropy plaintext token through its own secret manager.
# Production startup requires a valid digest.
EAL_INGEST_TOKEN_SHA256=
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-me
PUBLIC_BASE_URL=http://localhost:8080
