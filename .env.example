APP_ENV=development
RUST_LOG=info,eal=debug
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eal
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-me
PUBLIC_BASE_URL=http://localhost:8080
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Omit EMBEDDING_ENDPOINT to use the explicitly development-only deterministic
# feature-hash backend. Configure all fields below for real semantic embeddings.
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_MODEL_VERSION=
EMBEDDING_DIMENSIONS=
